{
  "name": "financas",
  "productName": "Finanças",
  "version": "1.7.2",
  "description": "Controle financeiro pessoal — cartoes, faturas, limites, ganhos e gastos",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luiz-Matheus21/financas.git"
  },
  "author": "Luiz Matheus",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:main && vite build",
    "preview": "npm run build && node scripts/rodar-electron.mjs .",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "testar:ocr": "node scripts/rodar-electron.mjs scripts/testar-ocr.mjs",
    "testar:sincronizacao": "node scripts/testar-sincronizacao.mjs",
    "testar:financeiro": "node scripts/testar-financeiro.mjs",
    "testar": "npm run testar:sincronizacao && npm run testar:financeiro && npm run testar:ocr",
    "gerar:icone": "node scripts/gerar-icone.mjs",
    "lancar": "node scripts/lancar.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "br.pessoal.bolso",
    "productName": "Finanças",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!src/**",
      "!scripts/**",
      "!release/**",
      "!resources/**",
      "!.git/**",
      "!*.md",
      "!vite.config.mts",
      "!tsconfig.json",
      "!.gitignore",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": "resources/tessdata",
        "to": "tessdata"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Financas-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Finanças",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "asarUnpack": [
      "**/node_modules/tesseract.js/**",
      "**/node_modules/tesseract.js-core/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Luiz-Matheus21",
        "repo": "financas",
        "private": false,
        "releaseType": "draft"
      }
    ]
  }
}
